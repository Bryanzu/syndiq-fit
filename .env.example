# Syndiq Fit Environment Configuration
# Copy this file to .env.local for local overrides.
# In production (e.g., Vercel, Netlify, Railway, VPS), configure these in your environment dashboard.

# Secret key for the admin pages (/admin/feedback and /admin/analytics). Checked on the server only.
# Without it the admin pages stay locked. ADMIN_FEEDBACK_KEY still works as an older name for the same key.
ADMIN_KEY=replace-with-a-long-random-string

# Anonymous usage counts. Upstash Redis REST credentials; the Vercel Marketplace integration sets these for you.
# Without them, local runs write to data/analytics.json and Vercel deployments don't keep counts.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Time zone the analytics days are counted in (default Africa/Lagos)
# ANALYTICS_TIMEZONE=Africa/Lagos
